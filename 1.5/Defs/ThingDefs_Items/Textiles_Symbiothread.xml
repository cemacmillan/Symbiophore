<?xml version="1.0" encoding="utf-8" ?>

<Defs>   
<ThingDef ParentName="ResourceBase">
   	 <defName>Symbiothread</defName>
        <label>silk</label>
        <description>A rare and beautiful fiber produced by certain arthropods and known for its unparalleled beauty and comfort. This silk was produced by a symbiophore.</description>
        <graphicData>
            <texPath>Things/Item/Resource/Silk</texPath>
             <graphicClass>Graphic_Single</graphicClass>
        </graphicData>
        <stackLimit>600</stackLimit>
    <statBases>
      <MaxHitPoints>200</MaxHitPoints>
      <MarketValue>8.25</MarketValue>
      <Beauty>3</Beauty>
      <Mass>0.024</Mass>
      <Flammability>0.5</Flammability>
      <DeteriorationRate>2.0</DeteriorationRate>
      <StuffPower_Armor_Sharp>1.25</StuffPower_Armor_Sharp>
      <StuffPower_Armor_Blunt>0.54</StuffPower_Armor_Blunt>
      <StuffPower_Armor_Heat>1</StuffPower_Armor_Heat>
      <StuffPower_Insulation_Cold>20</StuffPower_Insulation_Cold>
      <StuffPower_Insulation_Heat>20</StuffPower_Insulation_Heat>
    </statBases>
    <burnableByRecipe>true</burnableByRecipe>
    <healthAffectsPrice>false</healthAffectsPrice>
    <minRewardCount>90</minRewardCount>
    <stuffProps>
      <categories>
        <li>Fabric</li>
      </categories>
      <commonality>0.05</commonality>
<allowColorGenerators>true</allowColorGenerators>
     <!-- <color>(180,169,154)</color> -->
     <!-- Opaque RGB only: byte RGB + 0–1 alpha is parsed as alpha≈1/255 and vanishes on CutoutComplex. -->
     <color>(205,195,175)</color>

      <statFactors>
        <Flammability>0.4</Flammability>
        <MaxHitPoints>1.5</MaxHitPoints>
        <Beauty>5</Beauty>
      </statFactors>
    </stuffProps>
    <thingCategories>
      <li>Textiles</li>
    </thingCategories>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <thingSetMakerTags><li>RewardStandardCore</li></thingSetMakerTags>
    <comps>
      <li>
        <compClass>CompColorable</compClass>
      </li>
    </comps>
    <colorGeneratorInTraderStock Class="ColorGenerator_Options">
      <options>
        <li>
          <weight>5</weight>
          <only>(0.33,0.33,0.33,1)</only>
        </li>
        <li>
          <weight>10</weight>
          <min>(0.3,0.3,0.3,1)</min>
          <max>(0.9,0.9,0.9,1)</max>
        </li>
        <li>
          <weight>5</weight>
          <only>(0.9,0.9,0.9,1)</only>
        </li>
      </options>
    </colorGeneratorInTraderStock>
    <allowedArchonexusCount>80</allowedArchonexusCount>
   <modExtensions>
    <li Class="SlippersNmSpc.MaterialTagDefExtension">
      <materialTags>
        <li>ComfortMaterial</li>
        <li>InsulatingMaterial</li>
        <li>BeautyMaterial</li>
      </materialTags>
    </li>
  </modExtensions>
  </ThingDef>
  
</Defs>